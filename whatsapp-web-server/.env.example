# WhatsApp Web Server Configuration
# Copy to .env in the whatsapp-web-server directory

# Python API base URL (where your FastAPI backend runs)
PYTHON_API_URL=http://localhost:8000

# Port for the Node.js WhatsApp Web gateway server
WHATSAPP_WEB_PORT=3000

# Node environment (development or production)
NODE_ENV=development

# Shared secret guarding /send, /qr and /reconnect. Must match GATEWAY_TOKEN
# in the root .env exactly, or the API's calls here return 401.
# Blank is allowed only when NODE_ENV is not production; in production these
# endpoints return 503 until it is set.
GATEWAY_TOKEN=
