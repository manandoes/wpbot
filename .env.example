# ─────────────────────────────────────────────────────────────────────────────
# Local development (.env)
#
# In production none of this file is used — every value is set as an
# environment variable on the Render service. See RENDER.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Local Postgres, or paste the External Database URL from your Render database
# (Render Dashboard → wpbot-db → Connections → External Database URL).
DATABASE_URL=postgresql://wpbot:wpbot123@localhost:5432/wpbot

# ── AI Backend ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Service-to-service ───────────────────────────────────────────────────────
# FastAPI → WhatsApp gateway. In production: https://wpbot-whatsapp.onrender.com
WHATSAPP_WEB_SERVER_URL=http://localhost:3000

# WhatsApp gateway → FastAPI. In production: https://wpbot-api.onrender.com
# (set this in whatsapp-web-server/.env)
PYTHON_API_URL=http://localhost:8000

# Shared secret protecting the gateway's /send, /qr and /reconnect endpoints.
# Must be IDENTICAL on the API and the gateway. Leave blank locally to disable.
# Generate one: openssl rand -hex 32
GATEWAY_TOKEN=

# ── WhatsApp session storage ─────────────────────────────────────────────────
# Directory holding .wwebjs_auth / .wwebjs_cache. On Render this is the mounted
# disk (/var/data); leave blank locally to use the whatsapp-web-server folder.
WWEBJS_DATA_PATH=

# ── Admin Dashboard ──────────────────────────────────────────────────────────
ADMIN_PASSWORD=change_me_secure_admin_password

# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=change_me_to_64_char_hex_string

# Protects POST /send-message
SEND_MESSAGE_API_KEY=change_me

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated, no trailing slash.
# In production: https://wpbot-dashboard.onrender.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
