# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Used by docker-compose to create the database and build DATABASE_URL.
# Option A — postgres container (default, defined in docker-compose.yml):
POSTGRES_USER=wpbot
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=wpbot

# Option B — Google Cloud SQL (managed PostgreSQL):
#   1. Create a Cloud SQL Postgres 16 instance in GCP console
#   2. Remove the `postgres` service from docker-compose.yml
#   3. Uncomment and fill in the line below (use the public IP or Cloud SQL Auth Proxy)
# DATABASE_URL=postgresql://wpbot:password@<cloud-sql-public-ip>:5432/wpbot

# ── AI Backend ────────────────────────────────────────────────────────────────
NVIDIA_API_KEY=your_nvidia_api_key_here

# ── Admin Dashboard ───────────────────────────────────────────────────────────
ADMIN_PASSWORD=change_me_secure_admin_password

# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=change_me_to_64_char_hex_string

# ── CORS ──────────────────────────────────────────────────────────────────────
# In production, replace with your VM's IP or custom domain (no trailing slash)
# e.g. ALLOWED_ORIGINS=http://34.123.45.67  or  https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Local dev only (ignored inside Docker — docker-compose sets these itself) ─
# DATABASE_URL=postgresql://wpbot:password@localhost:5432/wpbot
# WHATSAPP_WEB_SERVER_URL=http://localhost:3000
